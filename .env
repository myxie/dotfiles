#
# Template environment variables for setup.sh
#

export EDITOR="vim"
export GITREPOS=$HOME/github # Git repository directory
export DOTFILES=$GITREPOS/dotfiles/ # Dotfiles path 
export PEARLS='pearls.md' # Pearls.md path
export SOURCE="~/.zshrc" # depends if we are using .zshrc or .bashrc

# Other relevant to local area
export DROPBOX='' # Dropbox Path 
export SCRATCH=''